---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ResenasBloque from "../components/ResenasBloque.astro";
import { hostal } from "../data/hostal";
---
<Base title={`Reseñas de huéspedes | ${hostal.nombre}, Barranca`} description={`Opiniones reales de quienes se hospedaron en ${hostal.nombre}, ${hostal.lema.charAt(0).toLowerCase() + hostal.lema.slice(1)}`}>
  <Header />
  <main>
    <section class="band" style="background:var(--soft)">
      <div class="wrap">
        <nav class="migas" aria-label="Ruta de navegación"><a href="/">Inicio</a> / Reseñas</nav>
        <ResenasBloque titulo="Opiniones de nuestros huéspedes" nivel="h1" />
      </div>
    </section>
  </main>
  <Footer />
</Base>
<style>:global(.migas){font-size:14px;color:var(--muted);margin-bottom:14px}:global(.migas a){color:var(--sea-ink)}</style>
