---
import { u } from "../utils/url";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TarjetaPost from "../components/TarjetaPost.astro";
import ResenasBloque from "../components/ResenasBloque.astro";
import Edificio from "../components/Edificio.astro";
import Mapa from "../components/Mapa.astro";
import { posts } from "../utils/blog";
const ultimos = (await posts()).slice(0, 3);
import { hostal, habitaciones, tranquilidad, ruta, faq } from "../data/hostal";
import Comida from "../components/Comida.astro";

const wa = (msg: string) => `https://wa.me/${hostal.whatsapp}?text=${encodeURIComponent(msg)}`;
const kmMin = 140, kmMax = 210;
const pos = (km: number) => ((km - kmMin) / (kmMax - kmMin)) * 100;
const ticks = Array.from({ length: (kmMax - kmMin) / 10 + 1 }, (_, i) => kmMin + i * 10);
const year = new Date().getFullYear();
---
<Base>
  <Header />

  <main>
    <section id="inicio" class="hero">
      <div class="hero-in">
        <div class="hero-txt">
          <h1>Un cuarto limpio y seguro en Barranca, a una cuadra de la plaza.</h1>
          <p class="hero-p">Desde aquí recorres el Norte Chico de día: Caral, la ciudad más antigua de América, las playas de pozas naturales y la Fortaleza de Paramonga. De noche vuelves a descansar.</p>
          <dl class="tarifa">
            {habitaciones.map((h) => (
              <div>
                <dt>{h.nombre}<small>{h.capacidad}</small></dt>
                <dd><span class="km">S/ <span data-precio={h.id}>{h.precio}</span></span> la noche</dd>
              </div>
            ))}
          </dl>
          <div class="hero-cta">
            <a class="btn btn-sun" href="#habitaciones">Elegir mi habitación</a>
            <a class="btn btn-ghost" href={wa(`Hola, quiero reservar en ${hostal.nombre}.`)}>Escribir por WhatsApp</a>
          </div>
          <p class="hero-cond">Check-in desde la {hostal.checkIn}, salida hasta las {hostal.checkOut}</p>
        </div>
        <figure class="hero-foto">
          <picture>
            <source type="image/webp" srcset={`${u("/img/fachada-hostal-anita-420.webp")} 420w, ${u("/img/fachada-hostal-anita.webp")} 760w`} sizes="(max-width: 860px) 100vw, 42vw" />
            <img src={u("/img/fachada-hostal-anita.jpg")} width="760" height="1270" alt={`Fachada de ${hostal.nombre}: edificio de cinco pisos con ventanas azules y letrero vertical`} fetchpriority="high" decoding="async" />
          </picture>
          <figcaption>Así se ve desde la calle {hostal.calle}</figcaption>
          <div class="poste" role="img" aria-label="Kilómetro 190 de la Panamericana Norte">
            <span class="poste-ruta">PE-1N</span>
            <span class="poste-km">190</span>
            <span class="poste-pie">Barranca</span>
          </div>
        </figure>
      </div>
    </section>

    <Edificio />

    <Mapa />

    <section class="band arena">
      <div class="wrap dos">
        <div>
          <h2>Después del paseo, llegas a un lugar seguro</h2>
          <p class="lead">Caral te pide madrugar y la playa te deja cansado. Aquí te espera una cama limpia, agua caliente y un lugar tranquilo para descansar.</p>
        </div>
        <ul class="tranq">
          {tranquilidad.map((x) => (
            <li><h3>{x.t}</h3><p>{x.d}</p></li>
          ))}
        </ul>
      </div>
    </section>


    <section id="resenas" class="band suave">
      <div class="wrap"><ResenasBloque limite={3} /></div>
    </section>

    <Comida />

    <section id="blog" class="band suave">
      <div class="wrap">
        <div class="blog-cab">
          <div>
            <h2>Guías para tu viaje</h2>
            <p class="lead">Lo que necesitas saber antes de venir a Barranca, escrito por quienes vivimos aquí.</p>
          </div>
          <a class="btn btn-sun" href={u("/blog/")}>Ver todas las guías</a>
        </div>
        <div class="tposts">{ultimos.map((post) => <TarjetaPost post={post} />)}</div>
      </div>
    </section>

    <section id="llegar" class="band">
      <div class="wrap dos">
        <div>
          <h2>Cómo llegar y preguntas frecuentes</h2>
          <p class="lead">{hostal.direccion}</p>
          <p style="margin-top:18px"><a class="btn btn-sun" href={hostal.mapsUrl}>Abrir en Google Maps</a></p>
        </div>
        <div class="faq">
          {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
        </div>
      </div>
    </section>
  </main>

  <Footer />

</Base>

<style>

.hero{border-bottom:1px solid var(--line)}
.hero-in{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);grid-template-rows:minmax(0,1fr);height:min(calc(100svh - 66px),800px);min-height:620px}
.hero-txt{align-self:center;padding:clamp(32px,6vh,80px) clamp(40px,5vw,80px) clamp(32px,6vh,80px) max(5vw,20px,calc((100vw - 1180px) / 2))}
.hero h1{font-size:clamp(38px,4.6vw,62px);line-height:1.05;max-width:15ch;color:var(--ink)}
.hero-p{font-size:19px;color:var(--muted);max-width:46ch;margin-top:22px}
.tarifa{display:grid;grid-template-columns:1fr 1fr;margin:34px 0 0;border-top:1px solid var(--ink);max-width:520px}
.tarifa>div{padding:14px 20px 0 0}
.tarifa>div+div{padding-left:20px;border-left:1px solid var(--line)}
.tarifa dt{font-weight:800;font-size:15px;display:flex;flex-wrap:wrap;gap:0 8px;align-items:baseline}
.tarifa dt small{font-weight:400;color:var(--muted);font-size:14px}
.tarifa dd{margin:2px 0 0;color:var(--muted)}
.tarifa dd .km{font-size:30px;color:var(--sea);margin-right:4px}
.hero-cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
.hero-cond{font-size:14px;color:var(--muted);margin-top:16px}
.hero-foto{position:relative;margin:0;background:var(--soft);min-height:0}
.hero-foto picture{overflow:hidden}
.hero-foto picture,.hero-foto img{display:block;width:100%;height:100%}
.hero-foto img{object-fit:cover;object-position:50% 30%}
.hero-foto figcaption{position:absolute;right:0;top:0;background:#fff;color:var(--muted);font-size:13px;padding:8px 14px}
.poste{position:absolute;left:-46px;bottom:56px;width:92px;padding:16px 0 12px;background:#fff;color:var(--ink);border:3px solid var(--ink);border-radius:46px 46px 4px 4px;display:flex;flex-direction:column;align-items:center;line-height:1;font-family:var(--text);box-shadow:6px 6px 0 var(--sun);animation:poste .7s cubic-bezier(.2,.7,.2,1) .2s both}
.poste-ruta{font-size:12px;font-weight:800;letter-spacing:.04em}
.poste-km{font-size:36px;font-weight:800;margin:8px 0 6px;font-variant-numeric:tabular-nums}
.poste-pie{font-size:11px;font-weight:600;color:var(--muted);border-top:2px solid var(--ink);padding-top:6px;width:76%;text-align:center}
@keyframes poste{from{transform:translateY(24px);opacity:0}to{transform:none;opacity:1}}

.regla{position:relative;height:56px;margin:44px 12px 0}
.via{position:absolute;left:0;right:0;top:22px;height:12px;border-radius:6px;background:#5b5148;
  background-image:linear-gradient(90deg,var(--sun) 50%,transparent 0);background-size:28px 2px;background-repeat:repeat-x;background-position:0 5px}
.tick{position:absolute;top:0;height:56px;border-left:2px solid var(--line);transform:translateX(-1px)}
.tick span{position:absolute;top:40px;left:4px;font-size:13px;color:var(--muted);font-weight:600}
.paradas{position:relative;height:96px;margin:0 12px}
.parada{position:absolute;left:var(--x);top:0;transform:translateX(-50%);background:none;border:0;padding:0;cursor:pointer;color:var(--ink);font:600 14px/1.2 var(--text);display:flex;flex-direction:column;align-items:center;width:88px;min-height:44px}
.parada:nth-child(even){top:42px}
.pin{width:20px;height:20px;border-radius:50%;background:var(--bg);box-shadow:inset 0 0 0 4px var(--sea);margin-bottom:6px}
.parada.base .pin{background:var(--sun);box-shadow:inset 0 0 0 4px #10262c}
.parada[aria-selected=true] .pin{background:var(--sea);box-shadow:0 0 0 5px color-mix(in srgb,var(--sea) 25%,transparent)}
.parada.base[aria-selected=true] .pin{background:var(--sun)}
.parada[aria-selected=true] .pnom{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:3px}
.pnom{text-align:center}

.lista{list-style:none;padding:0;margin:28px 0 0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,340px),1fr));gap:14px}
.item{display:grid;grid-template-columns:64px minmax(0,1fr);gap:16px;padding:18px;border-radius:var(--r);background:var(--soft);border:2px solid transparent;transition:border-color .25s}
.item.activo{border-color:var(--sea)}
.hito{background:#fff;color:#10262c;border:2px solid #10262c;border-radius:6px;height:58px;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1}
.hito span{font-size:12px;font-weight:600}
.hito b{font-size:22px}
.meta{color:var(--muted);font-size:15px;margin:4px 0 8px}
.nota{font-size:14px;color:var(--muted);margin-top:18px}

.dos{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(28px,5vw,72px);align-items:start}
.arena{background:var(--sea);color:#fff}
.arena .lead{color:#cfe2e3}
.arena h3{color:#fff}
.arena .tranq p{color:#cfe2e3}
.tranq,.platos{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 32px}
.tranq li{border-top:1px solid rgba(255,255,255,.35);padding-top:16px}
.tranq p,.platos p{margin-top:6px}
.mar{background:var(--sea);color:#fff}
.mar .lead{color:#cfe7e6}
.platos li{border-top:3px solid var(--sun);padding-top:14px}
.platos p{color:#dcefee}

.habs{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:20px;margin-top:32px}
.hab{border:1px solid var(--line);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column}
.foto{aspect-ratio:4/3;background:repeating-linear-gradient(135deg,var(--soft) 0 14px,color-mix(in srgb,var(--sand) 35%,var(--soft)) 14px 28px);display:flex;align-items:flex-end;padding:12px}
.foto span{font-size:13px;color:var(--muted);background:var(--bg);padding:4px 10px;border-radius:999px}
.hab-in{padding:20px;display:flex;flex-direction:column;gap:6px;flex:1}
.hab-in .btn{margin-top:auto;align-self:flex-start}
.precio{margin:8px 0 14px}.precio b{font-size:24px}

.form{background:var(--soft);border-radius:var(--r);padding:clamp(20px,3vw,32px);display:grid;gap:16px}
.fila{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.form label{display:grid;gap:6px;font-weight:600;font-size:15px}
.form input,.form select{font:16px var(--text);min-height:48px;padding:0 12px;border:1px solid var(--line);border-radius:var(--r);background:var(--bg);color:var(--ink);width:100%}
.form input:focus,.form select:focus{border-color:var(--sea);outline:none}
.res{font-weight:600}
.contacto{margin-top:22px}
.logo-full{display:block;width:min(240px,60%);height:auto;margin-bottom:24px;background:#fff;border-radius:var(--r);padding:14px}

.suave{background:var(--soft)}
.blog-cab{display:flex;flex-wrap:wrap;gap:16px 32px;align-items:flex-end;justify-content:space-between}
.faq details{border-bottom:1px solid var(--line);padding:4px 0}
.faq summary{cursor:pointer;font-weight:600;font-size:18px;list-style:none;display:flex;justify-content:space-between;gap:16px;align-items:center;padding:14px 0;min-height:44px;list-style-position:outside}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";font:400 26px/1 var(--text);color:var(--sea);flex:none}
.faq details[open] summary::after{content:"–"}
.faq details p{padding:0 0 16px;color:var(--muted)}



@media (max-width:900px){
  .hero-in{grid-template-columns:minmax(0,1fr);height:auto;min-height:0}
  .hero-foto{height:min(70vh,520px);order:-1}
  .poste{left:auto;right:20px;bottom:-30px;width:78px;border-radius:39px 39px 4px 4px}
  .poste-km{font-size:30px}
  .hero-txt{padding-top:56px}
  .hero-cta .btn{flex:1 1 100%}
  .tarifa dd .km{font-size:26px}
}
@media (max-width:860px){
  .dos{grid-template-columns:minmax(0,1fr)}
  .regla,.paradas{display:none}
  .lista{margin-top:20px}
}
@media (max-width:600px){
  .top nav a:not(.nav-cta){display:none}
  .tranq,.platos,.fila{grid-template-columns:minmax(0,1fr)}
}
</style>
