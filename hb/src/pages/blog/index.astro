---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import TarjetaPost from "../../components/TarjetaPost.astro";
import { posts } from "../../utils/blog";
import { hostal } from "../../data/hostal";
const lista = await posts();
const title = `Blog: qué hacer en Barranca y el Norte Chico | ${hostal.nombre}`;
const description = "Guías para viajar a Barranca: cómo llegar a Caral, las mejores playas, la Fortaleza de Paramonga, rutas de fin de semana y qué comer en el Norte Chico.";
---
<Base title={title} description={description} jsonld={{
  "@context": "https://schema.org", "@type": "Blog", name: `Blog de ${hostal.nombre}`, description,
  blogPost: lista.map((p) => ({ "@type": "BlogPosting", headline: p.data.title, datePublished: p.data.pubDate.toISOString(), url: new URL(`/blog/${p.id}/`, Astro.site).toString() })),
}}>
  <Header />
  <main>
    <section class="band blog-hero">
      <div class="wrap">
        <nav class="migas" aria-label="Ruta de navegación"><a href="/">Inicio</a> / Blog</nav>
        <h1>Viajar a Barranca y el Norte Chico</h1>
        <p class="lead">Guías escritas desde Barranca para que planifiques tu visita a Caral, las playas, Paramonga y todo lo que hay a pocos kilómetros.</p>
      </div>
    </section>
    <section class="band" style="padding-top:0">
      <div class="wrap tposts">
        {lista.map((post) => <TarjetaPost post={post} />)}
      </div>
    </section>
  </main>
  <Footer />
</Base>
<style>
.blog-hero{background:var(--soft)}
.blog-hero h1{font-size:clamp(34px,5vw,54px);color:var(--sea-ink)}
:global(.migas){font-size:14px;color:var(--muted);margin-bottom:14px}
:global(.migas a){color:var(--sea-ink)}
</style>
