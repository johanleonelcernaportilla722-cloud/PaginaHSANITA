---
import { u } from "../utils/url";
import { hostal } from "../data/hostal";
const wa = (msg: string) => `https://wa.me/${hostal.whatsapp}?text=${encodeURIComponent(msg)}`;
const year = new Date().getFullYear();
---
  <footer class="pie">
    <div class="wrap pie-in">
      <div>
        <img class="logo-pie" src={u("/img/logo-hostal-anita.svg")} alt={hostal.nombre} width="150" height="185" />
      </div>
      <div>
        <p class="bendicion">{hostal.bendicion}</p>
        <p>{hostal.direccion}<br/>WhatsApp {hostal.telefonoVisible}</p>
      </div>
      <nav aria-label="Enlaces">
        <a href={hostal.redes.facebook}>Facebook</a>
        <a href={hostal.redes.instagram}>Instagram</a>
        <a href={hostal.redes.tiktok}>TikTok</a>
        <a href={u("/resenas/")}>Reseñas</a>
        <a href={u("/blog/")}>Blog</a>
        <a href={u("/rss.xml")}>RSS</a>
      </nav>
      <p class="copy">© {year} {hostal.nombre}</p>
    </div>
  </footer>

  <a class="wa-float" href={wa(`Hola, quiero información de ${hostal.nombre}.`)} aria-label="Escríbenos por WhatsApp">
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4a.5.5 0 0 0 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.1.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.4-.3Z"/></svg>
  </a>

<style is:global>
.pie{background:var(--sea-deep);color:#dcefee;padding:40px max(5vw,16px)}
.pie-in{display:flex;flex-wrap:wrap;gap:20px 48px;justify-content:space-between;align-items:center}
.pie nav{display:flex;gap:20px;flex-wrap:wrap}
.pie a{color:#fff}
.copy{font-size:14px}
.logo-pie{display:block;width:150px;height:auto;background:#fff;border-radius:16px;padding:12px}
.bendicion{font:italic 500 24px/1.2 var(--script);color:var(--gold);margin-bottom:6px}
.wa-float{position:fixed;right:18px;bottom:18px;z-index:30;width:58px;height:58px;border-radius:50%;background:#25d366;color:#fff;display:grid;place-items:center;box-shadow:0 6px 20px rgba(9,58,69,.35)}
</style>
