---
const { valor = 5, tam = 18 } = Astro.props;
const llenas = Math.round(valor);
---
<span class="estrellas" role="img" aria-label={`${valor} de 5 estrellas`}>
  {[1, 2, 3, 4, 5].map((i) => (
    <svg viewBox="0 0 20 20" width={tam} height={tam} aria-hidden="true"><path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z" fill={i <= llenas ? "var(--gold)" : "none"} stroke="var(--gold)" stroke-width="1.4" stroke-linejoin="round"/></svg>
  ))}
</span>
<style>.estrellas{display:inline-flex;gap:2px;vertical-align:middle}</style>
