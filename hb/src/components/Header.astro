---
import { u } from "../utils/url";
import { hostal } from "../data/hostal";
const wa = `https://wa.me/${hostal.whatsapp}?text=${encodeURIComponent(`Hola, quiero reservar en ${hostal.nombre}.`)}`;
---
  <header class="top">
    <div class="wrap top-in">
      <a href={u("/")} class="marca" aria-label={`${hostal.nombre}, inicio`}>
        <img src={u("/img/isotipo-anita.svg")} alt="" width="58" height="42" />
        <span>{hostal.nombre}</span>
      </a>
      <nav aria-label="Secciones">
        <a href={u("/#habitaciones")}>Habitaciones</a>
        <a href={u("/#ruta")}>Qué visitar</a>
        <a href={u("/#comer")}>Qué comer</a>
        <a href={u("/blog/")}>Guías</a>
        <a href={u("/#llegar")}>Cómo llegar</a>
      </nav>
      <a href={wa} class="top-tel"><span class="top-tel-l">Reservas por WhatsApp</span> <b class="km">{hostal.telefonoVisible.replace("+51 ", "")}</b></a>
    </div>
  </header>

<style is:global>
.top{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.96);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.top-in{display:flex;align-items:center;gap:16px 36px;max-width:none;padding:12px max(5vw,20px,calc((100vw - 1180px) / 2))}
.marca{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--sea);flex:none}
.marca img{display:block;height:36px;width:auto}
.marca span{font:400 21px/1 var(--display)}
.top nav{display:flex;gap:4px 26px;flex-wrap:wrap;align-items:center;margin-left:auto}
.top nav a{text-decoration:none;font-weight:600;font-size:15px;padding:8px 0;color:var(--ink)}
.top nav a:hover{color:var(--sea);text-decoration:underline;text-decoration-thickness:2px}
.top-tel{display:flex;flex-direction:column;align-items:flex-end;text-decoration:none;color:var(--sea);line-height:1.15;padding-left:24px;border-left:1px solid var(--line)}
.top-tel-l{font-size:12px;color:var(--muted);font-weight:600}
.top-tel b{font-size:18px}
.top-tel:hover b{text-decoration:underline}
@media (max-width:960px){.top nav{display:none}.top-tel{margin-left:auto}}
@media (max-width:420px){.top-tel-l{display:none}.top-tel{border:0;padding:0}}
</style>
