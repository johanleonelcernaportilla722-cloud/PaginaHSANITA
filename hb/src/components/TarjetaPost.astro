---
import { u } from "../utils/url";
import Portada from "./Portada.astro";
import { temas, fecha, minutos } from "../utils/blog";
const { post } = Astro.props;
const src = (x: string) => (x.startsWith("http") ? x : u(x));
---
<article class="tpost">
  <a href={u(`/blog/${post.id}/`)} class="tpost-link">
    {post.data.imagen ? (
      <figure class="tpost-foto">
        <img src={src(post.data.imagen)} alt={post.data.imagenAlt ?? post.data.title} width="500" height="300" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
        {post.data.credito && <figcaption>Foto: {post.data.credito.autor}, {post.data.credito.licencia}</figcaption>}
      </figure>
    ) : <Portada tema={post.data.tema} alto={180} />}
    <div class="tpost-in">
      <p class="tpost-meta">{temas[post.data.tema]}, {minutos(post.body)} min de lectura</p>
      <h3>{post.data.title}</h3>
      <p>{post.data.description}</p>
      <p class="tpost-fecha"><time datetime={post.data.pubDate.toISOString()}>{fecha(post.data.pubDate)}</time></p>
    </div>
  </a>
</article>
<style is:global>
.tposts{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:40px 28px;margin-top:36px}
.tpost-link{display:block;text-decoration:none;color:inherit;height:100%}
.tpost-foto{position:relative;margin:0;aspect-ratio:3/2;overflow:hidden;background:var(--line);border-radius:var(--r)}
.tpost-foto img{width:100%;height:100%;object-fit:cover;display:block}
.tpost-foto figcaption{position:absolute;left:0;bottom:0;font:400 11px/1.2 var(--text);color:#fff;background:rgba(22,39,43,.7);padding:4px 8px;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tpost-in{padding:16px 0 0;display:grid;gap:8px}
.tpost h3{font-size:22px;line-height:1.2}
.tpost-link:hover h3{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px}
.tpost-meta{font-size:14px;color:var(--sea);font-weight:600}
.tpost-in>p:not([class]){color:var(--muted);font-size:16px}
.tpost-fecha{font-size:14px;color:var(--muted)}
.tpost .portada{border-radius:var(--r)}
</style>
