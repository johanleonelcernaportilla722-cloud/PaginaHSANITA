---
// Agenda "Qué pasa en Barranca": eventos que el dueño publica desde una hoja de Google.
// Columnas de la hoja: fecha | hasta | titulo | descripcion | lugar | imagen | enlace | publicar
import { hostal } from "../data/hostal";
---
<section id="agenda" class="band agenda" data-url={hostal.hojaEventos}>
  <div class="wrap">
    <div class="ag-cab">
      <div>
        <h2>Qué pasa en Barranca</h2>
        <p class="lead">Fiestas, aniversarios y fechas especiales para planear tu visita.</p>
      </div>
      <a class="btn btn-sun" href={`https://wa.me/${hostal.whatsapp}?text=${encodeURIComponent(`Hola, quiero reservar en ${hostal.nombre} para una fecha especial.`)}`}>Reservar para una fecha</a>
    </div>
    <div class="ag-lista" id="ag-lista" aria-live="polite">
      <p class="ag-vacio">Cargando la agenda…</p>
    </div>
  </div>
</section>

<script is:inline>
{
  const sec = document.getElementById('agenda');
  const lista = document.getElementById('ag-lista');
  const url = sec.dataset.url;
  const vacio = (t) => { lista.innerHTML = `<p class="ag-vacio">${t}</p>`; };
  const esc = (s) => String(s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  // CSV con comillas y comas dentro del texto
  const parseCSV = (t) => {
    const filas = []; let fila = [], campo = '', q = false;
    for (let i = 0; i < t.length; i++) {
      const c = t[i];
      if (q) { if (c === '"') { if (t[i + 1] === '"') { campo += '"'; i++; } else q = false; } else campo += c; }
      else if (c === '"') q = true;
      else if (c === ',') { fila.push(campo); campo = ''; }
      else if (c === '\n' || c === '\r') { if (c === '\r' && t[i + 1] === '\n') i++; fila.push(campo); filas.push(fila); fila = []; campo = ''; }
      else campo += c;
    }
    if (campo || fila.length) { fila.push(campo); filas.push(fila); }
    return filas;
  };
  // enlace de Google Drive → imagen directa
  const imagen = (u) => {
    u = (u || '').trim(); if (!/^https:\/\//.test(u)) return '';
    const m = u.match(/drive\.google\.com\/(?:file\/d\/|open\?id=|uc\?(?:export=\w+&)?id=)([\w-]+)/);
    return m ? `https://drive.google.com/thumbnail?id=${m[1]}&sz=w1000` : u;
  };
  const fecha = (s) => {
    s = (s || '').trim(); if (!s) return null;
    const m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);   // 24/12/2026
    const d = m ? new Date(+m[3], +m[2] - 1, +m[1], 12) : new Date(s + 'T12:00:00');
    return isNaN(d) ? null : d;
  };
  if (!url) { vacio('Pronto publicaremos las próximas actividades de Barranca.'); }
  else {
    fetch(url + (url.includes('?') ? '&' : '?') + 't=' + Date.now())
      .then((r) => (r.ok ? r.text() : Promise.reject()))
      .then((csv) => {
        const filas = parseCSV(csv);
        const cab = filas.shift().map((h) => h.trim().toLowerCase());
        const col = (f, n) => f[cab.indexOf(n)] || '';
        const hoy = new Date(); hoy.setHours(0, 0, 0, 0);
        const ev = filas
          .filter((f) => /^s[ií]$/i.test(col(f, 'publicar').trim()))
          .map((f) => ({ ini: fecha(col(f, 'fecha')), fin: fecha(col(f, 'hasta')), tit: col(f, 'titulo'), des: col(f, 'descripcion'), lug: col(f, 'lugar'), img: imagen(col(f, 'imagen')), link: col(f, 'enlace').trim() }))
          .filter((e) => e.ini && e.tit && (e.fin || e.ini) >= hoy)
          .sort((a, b) => a.ini - b.ini)
          .slice(0, 6);
        if (!ev.length) return vacio('Pronto publicaremos las próximas actividades de Barranca.');
        const dia = (d) => d.toLocaleDateString('es-PE', { day: 'numeric' });
        const mes = (d) => d.toLocaleDateString('es-PE', { month: 'short' }).replace('.', '');
        const largo = (d) => d.toLocaleDateString('es-PE', { day: 'numeric', month: 'long' });
        lista.innerHTML = ev.map((e) => {
          const ahora = e.ini <= hoy && (e.fin || e.ini) >= hoy;
          const rango = e.fin && e.fin > e.ini ? `Del ${largo(e.ini)} al ${largo(e.fin)}` : largo(e.ini);
          return `<article class="ag-ev">
            ${e.img ? `<img src="${esc(e.img)}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()">` : ''}
            <div class="ag-in">
              <div class="ag-fecha" aria-hidden="true"><b>${dia(e.ini)}</b><span>${mes(e.ini)}</span></div>
              <div>
                ${ahora ? '<p class="ag-hoy">Ahora en Barranca</p>' : ''}
                <h3>${esc(e.tit)}</h3>
                <p class="ag-meta">${esc(rango)}${e.lug ? `. ${esc(e.lug)}` : ''}</p>
                ${e.des ? `<p>${esc(e.des)}</p>` : ''}
                ${/^https:\/\//.test(e.link) ? `<a class="ag-link" href="${esc(e.link)}">Más información</a>` : ''}
              </div>
            </div>
          </article>`;
        }).join('');
      })
      .catch(() => vacio('No pudimos cargar la agenda en este momento. Escríbenos por WhatsApp y te contamos qué hay en Barranca.'));
  }
}
</script>

<style is:global>
.agenda{background:var(--bg)}
.ag-cab{display:flex;flex-wrap:wrap;gap:16px 32px;align-items:flex-end;justify-content:space-between}
.ag-lista{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,330px),1fr));gap:20px;margin-top:28px}
.ag-vacio{grid-column:1/-1;background:var(--soft);border-radius:16px;padding:22px;color:var(--muted)}
.ag-ev{border:2px solid var(--line);border-radius:18px;overflow:hidden;background:var(--bg);display:flex;flex-direction:column}
.ag-ev img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}
.ag-in{display:grid;grid-template-columns:64px minmax(0,1fr);gap:16px;padding:18px}
.ag-fecha{background:var(--sea);color:#fff;border-radius:14px;height:70px;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1}
.ag-fecha b{font:700 28px var(--display)}
.ag-fecha span{font-size:13px;font-weight:700;text-transform:capitalize;margin-top:4px;color:#ffe1a6}
.ag-ev h3{font-size:22px;color:var(--sea-ink);line-height:1.2}
.ag-meta{font-size:14px;color:var(--muted);margin:6px 0 8px}
.ag-hoy{display:inline-block;background:var(--gold);color:#10262c;font-size:12px;font-weight:800;padding:3px 10px;border-radius:999px;margin-bottom:6px}
.ag-link{display:inline-block;margin-top:8px;color:var(--sea-ink);font-weight:800}
</style>
