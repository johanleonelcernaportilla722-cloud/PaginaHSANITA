---
// Sección "Qué comer": platos típicos agrupados por momento del día, con ilustración propia.
import { comida } from "../data/hostal";
import { u } from "../utils/url";

const grupos = [
  { id: "desayuno", titulo: "Para el desayuno", nota: "Temprano, antes de salir a Caral." },
  { id: "almuerzo", titulo: "Para el almuerzo", nota: "Frente al mar o en el centro." },
  { id: "antojo", titulo: "Para el antojo", nota: "Dulces y algo para brindar." },
];
---
<section id="comer" class="band comer">
  <div class="wrap">
    <div class="comer-cab">
      <div>
        <h2>Qué comer en Barranca y el Norte Chico</h2>
        <p class="lead">Del tamal supano al tacu tacu: el mar y el valle se juntan en la mesa. Estos son los platos que tienes que probar.</p>
      </div>
    </div>

    {grupos.map((g) => (
      <div class="comer-grupo">
        <div class="comer-gcab">
          <h3 class="comer-mom">{g.titulo}</h3>
          <p class="comer-nota">{g.nota}</p>
        </div>
        <ul class="comer-lista">
          {comida.filter((c) => c.momento === g.id).map((c) => (
            <li class="plato">
              <figure class="plato-foto">
                <img src={c.foto} alt={c.n} width="500" height="375" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                {c.credito && <figcaption>Foto: <a href={c.credito.url} rel="noopener" target="_blank">{c.credito.autor}</a>, {c.credito.licencia}</figcaption>}
              </figure>
              <div class="plato-txt">
                <h4>{c.n} <span class="plato-de">{c.de}</span></h4>
                <p>{c.d}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <p class="comer-pie">¿Quieres saber más? Lee <a href={u("/blog/comida-tipica-de-barranca/")}>la guía de comida típica de Barranca</a>.</p>
  </div>


</section>

<style is:global>
.comer{background:var(--bg)}
.comer-cab{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:20px 40px}
.comer-grupo{margin-top:clamp(40px,5vw,64px);display:grid;grid-template-columns:minmax(0,220px) minmax(0,1fr);gap:20px 40px}
.comer-gcab{border-top:1px solid var(--ink);padding-top:14px}
.comer-mom{font:400 22px/1.2 var(--display);color:var(--ink);margin:0}
.comer-nota{color:var(--muted);margin:6px 0 0;font-size:15px}
.comer-lista{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,200px),1fr));gap:32px 24px}
.plato{display:flex;flex-direction:column}
.plato-foto{margin:0;position:relative;aspect-ratio:4/3;background:var(--soft);overflow:hidden;border-radius:var(--r)}
.plato-foto img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.plato-foto figcaption{position:absolute;left:0;bottom:0;font:400 11px/1.2 var(--text);color:#fff;background:rgba(22,39,43,.7);padding:4px 8px;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.plato-foto figcaption a{color:#fff}
.plato-txt{padding:14px 0 0}
.plato h4{font:400 20px/1.25 var(--display);color:var(--ink);margin:0}
.plato-de{display:block;font:600 13px/1.4 var(--text);color:var(--sea);margin-top:4px}
.plato p{color:var(--muted);margin:6px 0 0;line-height:1.55;font-size:16px}
.comer-pie{margin-top:clamp(36px,4vw,56px);color:var(--muted)}
.comer-pie a{color:var(--sea);font-weight:600}
@media (max-width:760px){.comer-grupo{grid-template-columns:minmax(0,1fr)}}
</style>
