---
// Portada: atardecer en Barranca con el Cristo Redentor del Cerro Colorado (ilustración propia).
---
<svg class="escena" viewBox="0 0 1440 820" preserveAspectRatio="xMidYMax slice" role="img" aria-label="Atardecer en Barranca: el Cristo Redentor sobre el Cerro Colorado, frente al mar">
  <defs>
    <linearGradient id="h-cielo" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0d3e57"/>
      <stop offset=".38" stop-color="#2f6d8f"/>
      <stop offset=".62" stop-color="#d9a35f"/>
      <stop offset=".8" stop-color="#f6c06a"/>
      <stop offset="1" stop-color="#ffd98f"/>
    </linearGradient>
    <radialGradient id="h-sol" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#fff6d6"/>
      <stop offset=".25" stop-color="#ffe3a0" stop-opacity=".9"/>
      <stop offset="1" stop-color="#ffb347" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="h-mar" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3f8c96"/><stop offset=".5" stop-color="#145a69"/><stop offset="1" stop-color="#083846"/>
    </linearGradient>
    <linearGradient id="h-cerro" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#8a5a3c"/><stop offset=".55" stop-color="#5e3b2a"/><stop offset="1" stop-color="#3a2419"/>
    </linearGradient>
    <linearGradient id="h-arena" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e9b877"/><stop offset="1" stop-color="#b9824d"/>
    </linearGradient>
    <linearGradient id="h-cristo" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#2c1d1a"/><stop offset=".62" stop-color="#4a3127"/><stop offset="1" stop-color="#e7b46b"/>
    </linearGradient>
    <filter id="h-blur" x="-20%" y="-50%" width="140%" height="200%"><feGaussianBlur stdDeviation="9"/></filter>
    <filter id="h-blur2"><feGaussianBlur stdDeviation="3"/></filter>
  </defs>

  <rect width="1440" height="820" fill="url(#h-cielo)"/>

  <!-- nubes doradas -->
  <g filter="url(#h-blur)" opacity=".9">
    <ellipse cx="1120" cy="150" rx="210" ry="26" fill="#f7c27a"/>
    <ellipse cx="1260" cy="210" rx="160" ry="20" fill="#ffd79a"/>
    <ellipse cx="980" cy="250" rx="190" ry="18" fill="#f0a868"/>
    <ellipse cx="300" cy="120" rx="240" ry="22" fill="#5d86a3"/>
    <ellipse cx="560" cy="200" rx="170" ry="16" fill="#e6a868" opacity=".7"/>
    <ellipse cx="1360" cy="330" rx="140" ry="16" fill="#ffcf8a"/>
  </g>
  <g filter="url(#h-blur2)" opacity=".85">
    <ellipse cx="1080" cy="140" rx="120" ry="7" fill="#fff0c8"/>
    <ellipse cx="1230" cy="202" rx="90" ry="6" fill="#fff4d6"/>
    <ellipse cx="940" cy="244" rx="80" ry="5" fill="#ffe2b0"/>
  </g>

  <!-- sol detrás del Cristo -->
  <circle cx="870" cy="455" r="230" fill="url(#h-sol)"/>
  <circle cx="870" cy="455" r="44" fill="#fff4cf"/>

  <!-- mar -->
  <path d="M0 520 H1440 V820 H0Z" fill="url(#h-mar)"/>
  <g stroke="#ffe6a8" stroke-linecap="round">
    <path d="M790 532 h170" stroke-width="5" opacity=".85"/>
    <path d="M760 552 h230" stroke-width="4" opacity=".6"/>
    <path d="M810 574 h130" stroke-width="4" opacity=".45"/>
    <path d="M760 600 h70 M900 600 h120" stroke-width="3" opacity=".35"/>
  </g>
  <g stroke="#bfe6e6" stroke-width="2" fill="none" opacity=".35" stroke-linecap="round">
    <path d="M60 640 q14 -7 28 0 t28 0"/><path d="M300 700 q14 -7 28 0 t28 0"/><path d="M160 760 q14 -7 28 0 t28 0"/>
    <path d="M480 650 q14 -7 28 0 t28 0"/><path d="M620 740 q14 -7 28 0 t28 0"/>
  </g>

  <!-- Cerro Colorado -->
  <path d="M560 820 C600 700 660 600 740 560 C790 536 830 520 880 518 C930 516 980 540 1030 580 C1110 640 1180 720 1260 820Z" fill="url(#h-cerro)"/>
  <path d="M880 518 C930 516 980 540 1030 580 C1110 640 1180 720 1260 820 H1190 C1120 730 1060 650 990 600 C950 572 915 556 880 552Z" fill="#2f1d14" opacity=".45"/>
  <path d="M740 560 C790 536 830 520 880 518" fill="none" stroke="#f4b56a" stroke-width="3" opacity=".7"/>
  <!-- mirador con baranda -->
  <path d="M790 528 H975" stroke="#6d4a35" stroke-width="5"/>
  <g stroke="#f1d6a8" stroke-width="2.4" opacity=".9">
    {Array.from({ length: 16 }, (_, i) => <line x1={796 + i * 11.5} y1="514" x2={796 + i * 11.5} y2="528"/>)}
  </g>
  <path d="M792 513 H978" stroke="#f6e3c0" stroke-width="3"/>

  <!-- Cristo Redentor (silueta a contraluz) -->
  <g transform="translate(830 512) scale(.9)">
    <rect x="-36" y="-30" width="72" height="30" fill="#3a2620"/>
    <rect x="-36" y="-30" width="72" height="5" fill="#e9b46e" opacity=".85"/>
    <!-- túnica -->
    <path d="M-17 -204 C-23 -150 -24 -90 -25 -30 H25 C24 -90 23 -150 17 -204Z" fill="url(#h-cristo)"/>
    <!-- brazos con mangas caídas -->
    <path d="M-15 -203 L-118 -194 C-124 -193 -128 -190 -127 -186 C-126 -182 -122 -181 -117 -182 C-86 -180 -50 -170 -20 -128Z" fill="url(#h-cristo)"/>
    <path d="M15 -203 L118 -194 C124 -193 128 -190 127 -186 C126 -182 122 -181 117 -182 C86 -180 50 -170 20 -128Z" fill="url(#h-cristo)"/>
    <!-- pliegues -->
    <path d="M-8 -150 C-10 -110 -11 -70 -13 -32 M6 -150 C8 -110 9 -70 11 -32 M-1 -176 V-32" stroke="#1c1311" stroke-width="2" fill="none" opacity=".5"/>
    <path d="M-60 -176 C-45 -165 -32 -150 -22 -132 M60 -176 C45 -165 32 -150 22 -132" stroke="#1c1311" stroke-width="1.8" fill="none" opacity=".45"/>
    <!-- cabeza -->
    <path d="M-5 -206 H5 V-200 H-5Z" fill="#3a2620"/>
    <ellipse cx="0" cy="-219" rx="10.5" ry="13.5" fill="url(#h-cristo)"/>
    <!-- luz de contorno -->
    <path d="M9 -229 C13 -220 12 -212 8 -206 M17 -203 C21 -150 23 -90 24 -32 M118 -194 C124 -193 128 -190 127 -186" stroke="#ffd58a" stroke-width="2.4" fill="none" opacity=".95"/>
  </g>

  <!-- costa y arena en primer plano -->
  <path d="M0 820 V760 C120 740 260 744 380 760 C460 772 520 792 560 820Z" fill="url(#h-arena)"/>
  <path d="M1240 820 C1290 770 1360 744 1440 736 V820Z" fill="url(#h-arena)"/>
  <path d="M0 760 C120 740 260 744 380 760 C460 772 520 792 560 820" fill="none" stroke="#fff3d6" stroke-width="3" opacity=".7"/>

  <!-- aves -->
  <path d="M640 300 q9 -9 18 0 q9 -9 18 0 M700 330 q7 -7 14 0 q7 -7 14 0 M610 345 q6 -6 12 0 q6 -6 12 0" fill="none" stroke="#14303b" stroke-width="2.6" stroke-linecap="round" opacity=".55"/>
</svg>

<style>
.escena{position:absolute;inset:0;width:100%;height:100%;display:block}
</style>
