---
import "@fontsource/young-serif/400.css";
import "@fontsource/overpass/400.css";
import "@fontsource/overpass/600.css";
import "@fontsource/overpass/800.css";
import { u } from "../utils/url";
import { hostal } from "../data/hostal";
const {
  title = `${hostal.nombre} · Tu refugio en Barranca, Norte Chico`,
  description = "Hostal Anita en Barranca: alojamiento seguro para recorrer Caral, Áspero, Paramonga, la Albufera de Medio Mundo y las playas del Norte Chico. Reserva por WhatsApp.",
  type = "website",
  image = "/img/logo-hostal-anita.png",
  jsonld,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(u(image), Astro.site);
const negocio = {
  "@context": "https://schema.org",
  "@type": "Hostel",
  name: hostal.nombre,
  slogan: hostal.lema,
  url: new URL(u("/"), Astro.site).toString(),
  logo: new URL(u("/img/logo-hostal-anita.png"), Astro.site).toString(),
  address: { "@type": "PostalAddress", streetAddress: hostal.calle, postalCode: hostal.codigoPostal, addressLocality: "Barranca", addressRegion: "Lima", addressCountry: "PE" },
  telephone: hostal.telefonoVisible,
  email: hostal.email,
  checkinTime: hostal.checkIn,
  checkoutTime: hostal.checkOut,
};
---
<!DOCTYPE html>
<html lang="es-PE">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0a5263" />
  <link rel="icon" type="image/svg+xml" href={u("/img/isotipo-anita.svg")} />
  <meta property="og:image" content={ogImage} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="application/rss+xml" title={`Blog de ${hostal.nombre}`} href={u("/rss.xml")} />
  <link rel="sitemap" href={u("/sitemap-index.xml")} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={hostal.nombre} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="es_PE" />
  <script type="application/ld+json" set:html={JSON.stringify(negocio)} />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <slot />
  <script is:inline define:vars={{ url: hostal.hojaDatos }}>
  {
    // Lee precios y cuartos ocupados desde Google Sheets (si hay hoja configurada)
    if (url) {
      fetch(url + (url.includes('?') ? '&' : '?') + 't=' + Date.now())
        .then((r) => (r.ok ? r.text() : Promise.reject(r.status)))
        .then((csv) => {
          const precios = {}, estados = {};
          csv.split(/\r?\n/).slice(1).forEach((linea) => {
            const [clave, valor] = linea.split(',').map((x) => (x || '').trim().replace(/^"|"$/g, ''));
            if (!clave || !valor) return;
            const n = Number(valor.replace(/[^0-9.]/g, ''));
            if (/^(ocupad[oa]|libre|disponible)$/i.test(valor)) estados[clave] = /^ocupad/i.test(valor) ? 'ocupado' : 'libre';
            else if (n > 0) precios[clave.toLowerCase()] = n;
          });
          document.querySelectorAll('[data-precio]').forEach((el) => {
            const p = precios[el.dataset.precio];
            if (p) el.textContent = p;
          });
          window.__hostalDatos = { precios, estados };
          document.dispatchEvent(new CustomEvent('hostal:datos', { detail: window.__hostalDatos }));
        })
        .catch(() => {});
    }
  }
  </script>
</body>
</html>

<style is:global>
/*
IDEA: el hito kilométrico de la Panamericana Norte. Barranca está en el km 190;
el hito es la firma de la web y se repite en el mapa y en las guías.
COLOR: blanco cal, neblina (el cielo gris de la costa), petróleo del logo,
dorado de la golondrina solo para la acción principal, tinta para el texto.
LETRA: Young Serif para títulos (cálida, de letrero de provincia);
Overpass para texto y números (viene de la letra de las señales viales).
*/
:root{
  color-scheme:light;
  --bg:#ffffff;
  --soft:#e8eeee;          /* neblina */
  --ink:#16272b;           /* tinta */
  --muted:#4f6266;
  --line:#cfd9d9;
  --sea:#0a5263; --sea-deep:#073c48; --aqua:#2f8f93; --gold:#c9963e;
  --sand:#efe3cb; --sun:#e4b866;
  --focus:#0a5263;
  --sea-ink:#0a5263;
  --display:"Young Serif",Georgia,serif;
  --script:"Young Serif",Georgia,serif;
  --text:"Overpass",system-ui,sans-serif;
  --r:4px;
}
*{box-sizing:border-box;min-width:0}
html{scroll-behavior:smooth;scroll-padding-top:80px}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.62 var(--text);overflow-x:clip;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:var(--display);font-weight:400;line-height:1.12;text-wrap:balance;margin:0;letter-spacing:-.005em}
h2{font-size:clamp(28px,3.4vw,40px)}
h3{font-size:21px}
p{margin:0;text-wrap:pretty}
a{color:inherit;text-underline-offset:3px}
::selection{background:var(--sun);color:var(--ink)}
:focus-visible{outline:3px solid var(--focus);outline-offset:3px;border-radius:2px}
.wrap{max-width:1180px;margin:0 auto}
.band{padding:clamp(56px,8vw,112px) max(5vw,20px)}
.lead{font-size:18px;color:var(--muted);max-width:58ch;margin-top:14px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:50px;padding:0 22px;border-radius:var(--r);font:800 16px/1 var(--text);text-decoration:none;border:0;cursor:pointer;transition:background-color .15s}
.btn-sun{background:var(--sun);color:var(--ink)}
.btn-sun:hover{background:#d9a94f}
.btn-ghost{background:transparent;color:var(--sea);box-shadow:inset 0 0 0 2px var(--sea)}
.btn-ghost:hover{background:var(--soft)}
.km{font-family:var(--text);font-weight:800;font-variant-numeric:tabular-nums;white-space:nowrap}
</style>
